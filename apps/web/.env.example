# Configurações do App
NEXT_PUBLIC_APP_URL=https://23092026-new-erp-marketplaces-web.vercel.app

# Integração Mercado Livre (Padrão Oficial Bling / Tiny - OAuth 2.0 com PKCE)
# Obtenha em: https://developers.mercadolivre.com.br/devcenter
ML_CLIENT_ID=seu_client_id_aqui
ML_CLIENT_SECRET=seu_client_secret_aqui
# O redirect URI deve ser exatamente o cadastrado no DevCenter do ML:
ML_REDIRECT_URI=https://23092026-new-erp-marketplaces-web.vercel.app/api/integrations/mercadolivre/callback
# Opcional (default: true): ativa PKCE S256 para máxima segurança
ML_USE_PKCE=true

# Segurança e Criptografia em Repouso (Tokens de Marketplace - AES-256-GCM)
# Chave de 32 bytes codificada em base64 (gere com: openssl rand -base64 32 ou node -e "console.log(crypto.randomBytes(32).toString('base64'))")
INTEGRATIONS_ENCRYPTION_KEY=

# Segredo para execução do cron de renovação preventiva de tokens
CRON_SECRET=
