{
  "manifest_version": 3,
  "name": "ERP Marketplaces - Coleta de Concorrentes",
  "version": "1.0.0",
  "description": "Extensão assistida para captura de anúncios concorrentes no Mercado Livre e Shopee com pareamento direto no seu ERP.",
  "permissions": [
    "storage",
    "activeTab",
    "declarativeNetRequest",
    "scripting"
  ],
  "host_permissions": [
    "*://*.mercadolivre.com.br/*",
    "*://*.shopee.com.br/*",
    "http://localhost/*",
    "http://localhost:*/*",
    "http://127.0.0.1/*",
    "http://127.0.0.1:*/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ERP Marketplaces - Conexão e Pareamento",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.mercadolivre.com.br/*",
        "*://*.shopee.com.br/*"
      ],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ]
}
